<?xml version="1.0" encoding="UTF-8"?>
<!-- ============================================================
     web.xml — Web Application Deployment Descriptor
     Maps URLs to Java Servlet classes.
     
     URL Pattern:
       /api/auth/*      → AuthServlet   (login, register, logout)
       /api/currency/*  → CurrencyServlet (list, convert)
       /api/admin/*     → AdminServlet  (add/update/delete currency)
       /api/history/*   → HistoryServlet (get/filter history)
     
     Author: Rohit Sharma
     ============================================================ -->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Global Currency Converter</display-name>

    <!-- =====================================================
         SERVLET DECLARATIONS
         ===================================================== -->

    <!-- AuthServlet: handles /api/auth/login, /api/auth/register -->
    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>servlet.AuthServlet</servlet-class>
    </servlet>

    <!-- CurrencyServlet: handles /api/currency/list, /api/currency/convert -->
    <servlet>
        <servlet-name>CurrencyServlet</servlet-name>
        <servlet-class>servlet.CurrencyServlet</servlet-class>
    </servlet>

    <!-- AdminServlet: handles /api/admin/* -->
    <servlet>
        <servlet-name>AdminServlet</servlet-name>
        <servlet-class>servlet.AdminServlet</servlet-class>
    </servlet>

    <!-- HistoryServlet: handles /api/history/* -->
    <servlet>
        <servlet-name>HistoryServlet</servlet-name>
        <servlet-class>servlet.HistoryServlet</servlet-class>
    </servlet>

    <!-- =====================================================
         SERVLET MAPPINGS (URL → Servlet)
         ===================================================== -->

    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/api/auth/*</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>CurrencyServlet</servlet-name>
        <url-pattern>/api/currency/*</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>AdminServlet</servlet-name>
        <url-pattern>/api/admin/*</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>HistoryServlet</servlet-name>
        <url-pattern>/api/history/*</url-pattern>
    </servlet-mapping>

    <!-- =====================================================
         DEFAULT WELCOME FILE
         ===================================================== -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!-- =====================================================
         SESSION TIMEOUT: 30 minutes
         ===================================================== -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>
